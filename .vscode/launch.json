    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--edge_ips=agx13:8882", "--mode=udp" , "--save_plot=False", "--view_plot=False", "save_results=True", "only_results=True"
            ]
        }
    ]
}